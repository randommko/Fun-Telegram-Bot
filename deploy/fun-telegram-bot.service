[Unit]
Description=Fun Telegram bot (fun-telegram-bot-1.0.jar)
Wants=network-online.target openvpn@tg-relay.service
After=network-online.target openvpn@tg-relay.service postgresql.service
# Перезапускаться бесконечно: бот сам делает 3 попытки регистрации и выходит.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/usr/bin/tg_bot_fun
# Секреты передаются переменными окружения: аргументы командной строки видны в ps.
EnvironmentFile=/etc/telegram-bot/fun.env
ExecStart=/usr/bin/java -jar /usr/bin/tg_bot_fun/fun-telegram-bot-1.0.jar
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
