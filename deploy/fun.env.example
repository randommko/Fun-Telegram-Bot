# Шаблон окружения Fun-бота. Реальные значения в репозиторий не попадают:
# на сервере файл собирается из GitHub Secrets, локально — из вашего окружения.
BOT_TOKEN=<токен Fun-бота из BotFather>
BOT_DB_URL=jdbc:postgresql://<host>:5432/<database>
BOT_DB_USER=fun_user
BOT_DB_PASSWORD=<пароль роли fun_user>
BOT_OWNER_CHAT_ID=<telegram user id владельца>
FUN_RESOURCES_PATH=/usr/bin/tg_bot_fun/resources

# Прокси нужен, только если Telegram недоступен напрямую.
# BOT_PROXY_TYPE=HTTP
# BOT_PROXY_HOST=127.0.0.1
# BOT_PROXY_PORT=12334
# BOT_PROXY_USER=
# BOT_PROXY_PASS=
